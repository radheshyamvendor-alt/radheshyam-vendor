generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                 String   @id @default(uuid())
  prescriptionNumber String?
  patientName        String?
  patientMobile      String?
  patientAddress     String?
  patientGender      String?
  patientAge         Int?
  medicines          String?
  status             String
  otp                String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  chemistId          String?
  chemistEmail       String?
}

model GmailConnection {
  id                    String    @id @default(uuid())
  chemistEmail          String    @unique
  gmailAddress          String
  encryptedRefreshToken String
  historyId             String?
  watchExpiry           DateTime?
  isActive              Boolean   @default(true)
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model GmailPrescription {
  id           String   @id @default(uuid())
  chemistEmail String
  sender       String?
  subject      String?
  filename     String
  attachmentId String
  messageId    String
  status       String   @default("PENDING") // PENDING, PROCESSED
  receivedAt   DateTime @default(now())

  @@unique([chemistEmail, messageId, filename])
}
